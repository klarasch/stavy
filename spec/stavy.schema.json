{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klarasch/stavy/raw/main/spec/stavy.schema.json",
  "title": "Stavy manifest",
  "description": "A framework-agnostic description of a prototype workspace: dimensions, templates, pages, scenarios, prototypes (slices), notes, boards. See SPEC.md.",
  "type": "object",
  "required": [
    "version",
    "product",
    "dimensions",
    "pages",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[12]"
    },
    "product": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "strings": {
      "type": "string",
      "description": "Path to the copy catalog JSON (locale → key → text)"
    },
    "viewer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolbar": {
          "enum": [
            "bottom",
            "top",
            "bottom-left",
            "bottom-right",
            "top-left",
            "top-right",
            "bar-bottom",
            "bar-top"
          ]
        },
        "base": {
          "type": "string",
          "pattern": "^(/[^/?#]+)*$",
          "description": "Path prefix the viewer is mounted under in the host app, e.g. \"/canvas\". Default: root."
        },
        "app": {
          "type": "string",
          "description": "Where the prototype app is served, as an origin or path prefix (e.g. \"http://localhost:5173\" or \"/app\"). Default: the viewer's own origin at its parent path. Must be same-origin for inspect, tours and pins."
        },
        "targetAttrs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Attributes a bare target id is looked up in, in order. Default [\"data-proto\",\"data-testid\"]. Any target that is not a bare id is used as a CSS selector as-is."
        },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "description": "The workspace page viewport: the size every kind:\"page\" state is rendered and captured at. Default 1920x1080, dpr 1. pages[].frame still overrides this per page.",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "dpr": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Device scale factor for the scan capture. Default 1."
            }
          }
        },
        "inspect": {
          "type": "object",
          "additionalProperties": false,
          "description": "What the inspector should know about this workspace's design system (SPEC §1.8). Every field is optional: without any of it the inspector still reports computed values and the var() chain behind them. See docs/INSPECT-ADAPTERS.md.",
          "properties": {
            "kits": {
              "type": "array",
              "description": "Component libraries the prototype is built from, so their components can be named and their internals collapsed.",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Shown in the panel, e.g. \"Acme\"."
                  },
                  "componentPrefix": {
                    "type": "string",
                    "description": "A component whose own name starts with this belongs to the kit, e.g. \"Ac\"."
                  },
                  "classPattern": {
                    "type": "string",
                    "format": "regex",
                    "description": "Regular expression matching a class the kit stamps on a component's root node; capture group 1 must be the component's name, e.g. \"^(Ac[A-Z]\\\\w*)-module_\". This is what names components written as anonymous forwardRef wrappers."
                  }
                }
              }
            },
            "tokenPattern": {
              "type": "string",
              "format": "regex",
              "description": "A custom property matching this is a design token — where a var() chain stops, e.g. \"^--acme-\". Also how the viewer detects, per frame document, that this design system is the one in use."
            },
            "privateTokenPattern": {
              "type": "string",
              "format": "regex",
              "description": "A custom property matching this is a private primitive: reported as such, never as a token, e.g. \"^--acme-_\"."
            },
            "spacingTokenPattern": {
              "type": "string",
              "format": "regex",
              "description": "Narrows which tokens are offered as names for spacing and radius values. Default: tokenPattern."
            },
            "typeScale": {
              "type": "array",
              "description": "The type scale, for naming what an element's computed type is.",
              "items": {
                "type": "object",
                "required": ["name", "family", "size", "weight", "lineHeight"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "family": { "type": "string", "description": "One family name, as it appears first in the computed font stack." },
                  "size": { "type": "number", "description": "px" },
                  "weight": { "type": "number" },
                  "lineHeight": { "type": "number", "description": "A ratio (1.5) or px (21); values above 4 are read as px." }
                }
              }
            },
            "componentAttrs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Attributes that mark UI-kit components in the DOM. Default [\"data-slot\",\"data-component\"]."
            },
            "module": {
              "type": "string",
              "description": "Same-origin ES module the viewer imports at startup, default-exporting { framework?, designSystem? } partials merged over the built-in adapter. Only for what the data above cannot say."
            }
          }
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "values"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "Advisory tag: state | role | lifecycle | process | locale | preference | anything"
          },
          "scope": {
            "enum": [
              "page",
              "workspace"
            ],
            "default": "page",
            "description": "\"page\" (default): a local axis, reset when another page opens. \"workspace\": one value for the whole workspace, chosen in the viewer chrome and carried across navigation; a page that declares it and excludes the active value drops off the canvas. The first value is the workspace default."
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/valueId"
                },
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Path of the template implementation"
          },
          "uiKit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "organisms": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "description": "Registered components (kind: component) this template composes"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "description": "Free-text section this page belongs to (\"Onboarding\", \"Approvals\"). The canvas clusters page areas by it, in first-appearance order; ungrouped pages come last."
          },
          "kind": {
            "enum": [
              "page",
              "component"
            ]
          },
          "frame": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "Where the prototype renders this page: a path with {dim} placeholders, e.g. \"/expenses/exp-1?role={role}&state={state}\". Every dimension the page declares must appear as a placeholder — that is the whole binding contract."
          },
          "template": {
            "$ref": "#/$defs/id",
            "description": "Optional grouping label (a registered template id) — informational, the viewer renders the page's url"
          },
          "fidelity": {
            "enum": [
              "static",
              "navigable",
              "interactive"
            ]
          },
          "dimensions": {
            "$ref": "#/$defs/dimensionMap",
            "description": "Dimension id -> supported value ids. Optional: a page with no axes is normal and shows one card on the canvas."
          },
          "defaults": {
            "$ref": "#/$defs/dims"
          },
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dims"
              ],
              "additionalProperties": false,
              "properties": {
                "dims": {
                  "$ref": "#/$defs/dims"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "title",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "#/$defs/target"
                },
                "title": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Requirement references (PRD sections, tickets)"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "page",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "page": {
                  "$ref": "#/$defs/id"
                },
                "dims": {
                  "$ref": "#/$defs/dims"
                },
                "target": {
                  "$ref": "#/$defs/target"
                },
                "title": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "prototypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "pages",
          "scenarios"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "scenarios": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "page"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "type": "string"
          },
          "page": {
            "$ref": "#/$defs/id"
          },
          "dims": {
            "$ref": "#/$defs/dims"
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "placement": {
            "enum": [
              "top",
              "right",
              "bottom",
              "left"
            ]
          },
          "offset": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          }
        }
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "mermaid",
              "image",
              "text"
            ]
          },
          "source": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 100
          },
          "page": {
            "$ref": "#/$defs/id",
            "description": "Anchors the board to a page: it renders inside that page's canvas area as a figure instead of in the Boards area."
          },
          "callouts": {
            "type": "array",
            "description": "Numbered callouts over an image board, as fractions (0..1) of the image. `kind: \"image\"` only.",
            "items": {
              "type": "object",
              "required": [
                "x",
                "y",
                "title"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "$ref": "#/$defs/fraction"
                },
                "y": {
                  "$ref": "#/$defs/fraction"
                },
                "w": {
                  "$ref": "#/$defs/fraction"
                },
                "h": {
                  "$ref": "#/$defs/fraction"
                },
                "title": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "callouts"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "image"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case identifier"
    },
    "valueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "A fraction (0..1) of the frame it is measured against."
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "A semantic target: a bare id (letters, digits, _ : . -) resolved through viewer.targetAttrs, or any CSS selector."
    },
    "dims": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/valueId"
      }
    },
    "dimensionMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/valueId"
        }
      }
    }
  }
}
